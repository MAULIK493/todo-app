# Browser app (public values; safe to ship). Find them in Supabase: Project settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Set to true once Google is enabled in Supabase (shows "Continue with Google").
VITE_GOOGLE_AUTH=true
# Server-side secrets (ANTHROPIC_API_KEY, STT_*) are NOT set here.
# Set them with `supabase secrets set ...` -- see DEPLOY.md.
